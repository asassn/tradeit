<?xml version="1.0" encoding="UTF-8"?>
<!--
  The daily forward capture, approved by the owner 2026-10-20.

  Install:
    cp ops/com.tradeit.forward-capture.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.tradeit.forward-capture.plist

  Remove:
    launchctl unload ~/Library/LaunchAgents/com.tradeit.forward-capture.plist

  22:10 Eastern is after the US close and after Tiingo has settled the day,
  expressed here in local time because launchd has no timezone field. A run
  that fires before the data exists records a silence, which is not wrong --
  the observation is honest -- but it is a silence about the vendor rather than
  about the market, and those should not be confused.

  **StandardError is a file, not /dev/null.** A daily job that fails quietly is
  worse than one that never ran: the record simply stops growing and nothing
  says so. `tradeit status` reads the capture's own record, and this file is
  where a crash before that record is written ends up.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradeit.forward-capture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ericsasson/Documents/GitHub/TradeIt/ops/forward_daily.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>22</integer>
        <key>Minute</key><integer>10</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ericsasson/Documents/TradeItData/out/forward_capture.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ericsasson/Documents/TradeItData/out/forward_capture.err</string>

    <key>WorkingDirectory</key>
    <string>/Users/ericsasson/Documents/GitHub/TradeIt</string>

    <!--
      Not RunAtLoad. Installing the job should not fire a capture at whatever
      moment the install happens: the first run would stamp an asked_at that
      has nothing to do with the schedule, and the operator would be left
      unsure whether the job works or whether that one run was manual.
      Run ops/forward_daily.sh by hand once to check it, which is a decision
      rather than a side effect.
    -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
