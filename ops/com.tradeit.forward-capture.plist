<?xml version="1.0" encoding="UTF-8"?>
<!--
  The daily forward capture, approved by the owner 2026-10-20.

  Install:
    cp ops/com.tradeit.forward-capture.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.tradeit.forward-capture.plist

  Remove:
    launchctl bootout gui/$UID/com.tradeit.forward-capture

  Run once now, to check it:
    launchctl kickstart -k gui/$UID/com.tradeit.forward-capture

  `load`/`unload` are the deprecated spellings and report success on a plist
  launchd then refuses; `bootstrap` fails loudly instead, which is what an
  install step should do.

  22:10 Eastern is after the US close and after Tiingo has settled the day,
  expressed here in local time because launchd has no timezone field. A run
  that fires before the data exists records a silence, which is not wrong —
  the observation is honest — but it is a silence about the vendor rather than
  about the market, and those should not be confused.

  **StandardError is a file, not /dev/null.** A daily job that fails quietly is
  worse than one that never ran: the record simply stops growing and nothing
  says so. `tradeit status` reads the capture's own record, and this file is
  where a crash before that record is written ends up.
-->
<!--
  **No double hyphen inside these comments** — the sequence cannot be written
  here at all, which is why this rule is stated in words. XML forbids it within a
  comment, and this file had three. `plutil -lint` accepts them because Apple's
  parser is lenient, and launchd runs the job quite happily — which is why it
  went unnoticed — but every strict XML reader rejects the file outright.
  Found 2026-10-23 by reading the installed copy with Python's parser while
  checking something else. Use an em dash instead.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradeit.forward-capture</string>

    <!--
      **Python is invoked directly; there is no shell wrapper, and adding one
      would break the job.** macOS TCC grants file access per executable: in
      this session `/bin/bash` cannot read a file under ~/Documents while the
      framework interpreter can, so the shell version of this job failed with
      `Operation not permitted` before running a line. The reasoning and the
      measurements are in ops/forward_daily.py; do not condense this back into
      a .sh.

      `.venv/bin/python` is a symlink to /Library/Frameworks/Python.framework,
      which is the executable TCC actually evaluates — hence launchd may exec
      it even though the symlink is under ~/Documents.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ericsasson/Documents/GitHub/TradeIt/.venv/bin/python</string>
        <string>/Users/ericsasson/Documents/GitHub/TradeIt/ops/forward_daily.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>22</integer>
        <key>Minute</key><integer>10</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ericsasson/Documents/TradeItData/out/forward_capture.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ericsasson/Documents/TradeItData/out/forward_capture.err</string>

    <key>WorkingDirectory</key>
    <string>/Users/ericsasson/Documents/GitHub/TradeIt</string>

    <!--
      Not RunAtLoad. Installing the job should not fire a capture at whatever
      moment the install happens: the first run would stamp an asked_at that
      has nothing to do with the schedule, and the operator would be left
      unsure whether the job works or whether that one run was manual.
      Run `launchctl kickstart` once to check it, which is a decision rather
      than a side effect. Running ops/forward_daily.py from a terminal also
      works and is the right way to debug it — but note that it then runs
      under the terminal's TCC grant rather than launchd's, so a terminal pass
      does not prove the scheduled job can read anything.
    -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
