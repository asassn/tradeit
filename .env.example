# Copy to .env and adjust. Every value here is a safe local default.

TRADEIT_ENVIRONMENT=development
TRADEIT_LOG_LEVEL=INFO
TRADEIT_LOG_JSON=false

# backtest | paper | live
# "live" additionally requires ~/.tradeit/LIVE_TRADING_AUTHORIZED to contain the
# exact authorization phrase. Setting this variable alone will NOT enable live
# trading -- that is deliberate. See docs/adr/0004.
TRADEIT_TRADING_MODE=paper

TRADEIT_DB_DSN=postgresql+psycopg://tradeit:tradeit@localhost:5432/tradeit
TRADEIT_DB_POOL_SIZE=5
TRADEIT_DB_ECHO_SQL=false

TRADEIT_REDIS_DSN=redis://localhost:6379/0

TRADEIT_DATA_PRICE_PROVIDER=synthetic
TRADEIT_DATA_FUNDAMENTAL_PROVIDER=synthetic
TRADEIT_DATA_EXCHANGE_CALENDAR=XNYS
TRADEIT_DATA_DAILY_BAR_PUBLICATION_LAG_MINUTES=20
TRADEIT_DATA_ASSUMED_FILING_LAG_DAYS=45

# Set to a throwaway database to enable the PostgreSQL integration tests.
# TRADEIT_TEST_PG_DSN=postgresql+psycopg://tradeit:tradeit@localhost:5432/tradeit_test

# EODHD API token. Copy this file to .env and paste yours after the '='.
# .env is gitignored; a token in any other file is one `git add .` away from
# being published, and a published key cannot be unpublished.
# EODHD_API_TOKEN is also accepted -- it is the name EODHD's own docs use.
EODHD_API_KEY=

# Tiingo API key -- the free tier is enough to test coverage. Read by
# src/tradeit/acquisition/tiingo.py, which sends it in an Authorization header,
# never in a URL. TRADEIT_TIINGO_TOKEN is also accepted (the Phase 1 name).
TIINGO_API_KEY=

# Financial Modeling Prep API key -- the free tier is enough to test coverage.
# Read by src/tradeit/acquisition/fmp.py.
FMP_API_KEY=

# Sharadar API key (Prices plan). Read by scripts/research01_probe_sharadar.py.
# Sharadar takes it as an `api_key` query parameter, so every URL and error the
# probe records is passed through redaction before it is printed or saved.
SHARADAR_API_KEY=
